<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/rootSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".frag.ZipFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:layout_width="0dp"
                android:layout_height="?actionBarSize"
                android:elevation="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="?actionBarSize"
                    android:gravity="center_vertical"

                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/iv_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dimen_5dp"
                            android:src="@drawable/ic_back" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="18dp"
                        android:fontFamily="@font/itc_avant_garde_std_demi"
                        android:text="@string/settings"
                        android:textColor="#383B44"
                        android:textSize="20sp" />

                </LinearLayout>

            </com.google.android.material.appbar.AppBarLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

                <TextView
                    android:id="@+id/tvShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_start_end"
                    android:layout_marginTop="@dimen/dimen50dp"
                    android:background="@drawable/bg_button_setting"
                    android:drawablePadding="@dimen/dimen10dp"
                    android:fontFamily="@font/gilroy_light"
                    android:padding="@dimen/dimen10dp"
                    android:text="@string/share"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_share" />


                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_start_end"
                    android:layout_marginTop="@dimen/dimen25dp"
                    android:background="@drawable/bg_button_setting"
                    android:drawablePadding="@dimen/dimen10dp"
                    android:fontFamily="@font/gilroy_light"
                    android:padding="@dimen/dimen10dp"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/feedback"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_feedback" />


                <TextView
                    android:id="@+id/tvRateUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_start_end"
                    android:layout_marginTop="@dimen/dimen25dp"
                    android:background="@drawable/bg_button_setting"
                    android:drawablePadding="@dimen/dimen10dp"
                    android:fontFamily="@font/gilroy_light"
                    android:padding="@dimen/dimen10dp"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/rate_us"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_rate_us" />


                <TextView
                    android:id="@+id/tvPrivacyAdmob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_start_end"
                    android:layout_marginTop="@dimen/dimen25dp"
                    android:background="@drawable/bg_button_setting"
                    android:drawablePadding="@dimen/dimen10dp"
                    android:fontFamily="@font/gilroy_light"
                    android:padding="@dimen/dimen10dp"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/str_settings_privacy_admob"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_16"
                    android:visibility="gone"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_privacy_admod"
                    tools:visibility="visible" />


                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/space_start_end"
                    android:layout_marginBottom="@dimen/dimen50dp"
                    android:fontFamily="@font/gilroy_light"
                    android:gravity="bottom|center"
                    android:paddingVertical="@dimen/dimen5dp"
                    android:textAlignment="center"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_14"
                    tools:text="Version: " />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>